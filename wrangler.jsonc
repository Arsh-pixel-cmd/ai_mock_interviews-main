{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prepwise",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prepwise-db",
      "database_id": "58a4c8c4-21c8-49dd-8da5-5d2f86ffcace"
    }
  ]
}
